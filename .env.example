# 服务器配置
PORT=3000
HOST=0.0.0.0

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=campus_wall

# JWT密钥
JWT_SECRET=your_jwt_secret_key_change_this

# 首次初始化超级管理员（执行 npm run bootstrap:admin 前填写；不会在 npm start 时自动创建）
# 用户名只能使用字母、数字、下划线和连字符；密码至少 12 位。
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NICKNAME=站点管理员

# 学校名称
SCHOOL_NAME=XX大学

# 本地开发可保持 localhost；部署时替换为站点自己的 HTTPS 域名。
ALLOWED_ORIGINS=http://localhost:3000
SITE_URL=http://localhost:3000
PUBLIC_WALL_ORIGIN=http://localhost:3000

# AI 配置（智谱 GLM-4.6V-Flash，Key 只放在服务器 .env/.env.local）
GLM_API_KEY=your_zhipu_api_key
# 可选：模型、超时和思考模式（enabled/disabled）
# GLM_MODEL=glm-4.6v-flash
# GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# GLM_TIMEOUT_MS=15000
# GLM_STREAM_TIMEOUT_MS=60000
# GLM_THINKING=disabled

# 当前 AI provider 仅使用 GLM-4.6V-Flash；未配置或上游失败时不会切换其他模型

# 百度主动推送（可选；真实 token 只放在服务器环境变量）
# BAIDU_SITE_URL=https://campus-wall.example
# BAIDU_PUSH_API=http://data.zz.baidu.com/urls
# BAIDU_PUSH_TOKEN=your_baidu_push_token

# 微信公众号回调（真实 Token/AES Key 只放在服务器环境变量）
# WECHAT_TOKEN=your_wechat_token
# WECHAT_ENCODING_AES_KEY=your_wechat_encoding_aes_key
# WECHAT_APPID=your_wechat_appid
# WECHAT_SIGNATURE_TTL_SECONDS=300
# WECHAT_BODY_LIMIT_BYTES=262144

# 上传配置
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./public/uploads

# webhook 验证密钥（仅配置在私有部署环境，禁止提交真实值）
DEPLOY_SECRET=your_deploy_secret_change_this

# 云存储配置（可选）
# OSS_ENABLED=false
# OSS_REGION=
# OSS_ACCESS_KEY=
# OSS_ACCESS_SECRET=
# OSS_BUCKET=
