# ===========================================
# 校园墙 - 环境变量配置模板
# 复制本文件为 .env 并填入真实值
# ===========================================

# ===== 服务器 =====
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ===== 数据库 (MySQL 5.7+ / 8.0) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_wall

# ===== 安全 =====
# 用于 JWT 签名，务必改成强随机字符串
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ===== 站点信息 =====
# 学校名称（显示在前台顶部/底部）
SCHOOL_NAME=你的学校名
# 站点名称
SITE_NAME=校园墙
# 站点域名（不含协议，用于生成完整 URL）
SITE_DOMAIN=your-domain.com
# 联系邮箱
CONTACT_EMAIL=admin@your-domain.com

# ===== 管理员初始账号 =====
# 首次启动时自动创建
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# ===== 跨域白名单（逗号分隔） =====
ALLOWED_ORIGINS=https://your-domain.com

# ===== 文件上传 =====
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./public/uploads

# ===== 微信小程序 / 公众号（可选） =====
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=

# ===== AI 服务（任选其一） =====
# MiniMax（Anthropic 兼容）
MINIMAX_API_KEY=
# DeepSeek
DEEPSEEK_API_KEY=

# ===== 邮件服务（找回密码用，可选） =====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=校园墙

# ===== 第三方 API（可选） =====
# 一言 API（前台每日一言）
HITOKOTO_API=https://v1.hitokoto.cn
