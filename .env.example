# 服务器配置
PORT=3000
HOST=0.0.0.0

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=campus_wall

# JWT密钥
JWT_SECRET=your_jwt_secret_key_change_this

# 管理员初始账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 学校名称
SCHOOL_NAME=XX大学

# AI 配置：优先使用腾讯混元 CloudBase，其次 GLM，再其次千问。
# 真实密钥只放在服务器 .env/.env.local，禁止提交。
# CloudBase 成长计划需要通过 @cloudbase/node-sdk 调用，不能直接把 API Key
# 发到 /v1/ai/cloudbase 的普通 HTTPS 请求。
# CLOUDBASE_ENV_ID=your_cloudbase_environment_id
# CLOUDBASE_APIKEY=your_cloudbase_server_api_key
# HUNYUAN_MODEL=hy3
# HUNYUAN_TIMEOUT_MS=60000

# 智谱 GLM-4.6V-Flash（混元不可用时的第二顺位）
GLM_API_KEY=your_zhipu_api_key
# 可选：模型、超时和思考模式（enabled/disabled）
# GLM_MODEL=glm-4.6v-flash
# GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# GLM_TIMEOUT_MS=10000
# GLM_STREAM_TIMEOUT_MS=60000
# GLM_THINKING=disabled

# 可选：阿里云百炼千问纯文本备用。仅混元和 GLM 都不可用时接手；
# 图片识别和流式生成仍使用 GLM。
# 在百炼创建与部署地域相同的 API Key 后填入，勿提交真实 Key。
# DASHSCOPE_API_KEY=your_dashscope_api_key
# QWEN_MODEL=qwen-plus
# 建议使用百炼控制台提供的 workspace 兼容接口；未设置时使用兼容接口默认地址。
# QWEN_API_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
# QWEN_TIMEOUT_MS=10000

# 百度主动推送（可选；真实 token 只放在服务器环境变量）
# BAIDU_SITE_URL=http://localhost:3000
# BAIDU_PUSH_API=http://data.zz.baidu.com/urls
# BAIDU_PUSH_TOKEN=your_baidu_push_token

# 微信公众号回调（真实 Token/AES Key 只放在服务器环境变量）
# WECHAT_TOKEN=your_wechat_token
# WECHAT_ENCODING_AES_KEY=your_wechat_encoding_aes_key
# WECHAT_APPID=your_wechat_appid
# WECHAT_SIGNATURE_TTL_SECONDS=300
# WECHAT_BODY_LIMIT_BYTES=262144

# 上传配置
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./public/uploads

# webhook 验证密钥（仅配置在私有部署环境，禁止提交真实值）
DEPLOY_SECRET=your_deploy_secret_change_this

# 云存储配置（可选）
# OSS_ENABLED=false
# OSS_REGION=
# OSS_ACCESS_KEY=
# OSS_ACCESS_SECRET=
# OSS_BUCKET=
